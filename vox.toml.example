# Vox config example. Copy to ~/.vox/vox.toml and edit.
# Override path with VOX_CONFIG env. Env vars VOX_HOTKEY, VOX_DEVICE_ID, etc. override these values.
# Or open `vox settings` and let the supported fields autosave back to this file.

# Required: global hotkey to start/stop recording. Format: modifier+key (e.g. ctrl+shift+v).
hotkey = "ctrl+shift+v"

# Optional: audio input device ID from `vox devices`. Omit or leave unset for default device.
# device_id = 0

# Optional: faster-whisper model size (tiny, base, small, medium, large-v3, etc.) or path to model dir.
# Default: base. First run downloads from Hugging Face.
model_size = "base"

# Optional: compute type for inference: float32, float16, int8, int8_float16.
# Use int8 for lower memory on CPU. Default: float32.
compute_type = "float32"

# Optional: compute device: cpu or cuda. Default: cpu.
# Use cuda with compute_type float16 or int8 when GPU and CUDA 12 / cuDNN 9 are available.
compute_device = "cpu"

# Optional: use system tray instead of the Stop window. Default: false.
# When true, Vox shows a tray icon; choose Quit from the menu to stop. Env: VOX_TRAY=1.
# use_tray = false

# Optional: recording cue playback volume from 0.0 to 1.0. Default: 0.5.
# Set lower if the start/end cues are too loud. In `vox settings`, slider changes
# autosave after a short debounce and then preview the cue automatically. Env: VOX_CUE_VOLUME.
cue_volume = 0.5

# Optional: how to inject transcribed text.
# - "clipboard": only set clipboard (default).
# - "clipboard_and_paste": set clipboard and paste into focused window (needs
#   accessibility permission). After paste, Vox restores the previous clipboard
#   text ~150 ms later when safe. Restore is text-only (non-text contents are
#   not preserved).
# - "type": type directly into the focused window without modifying the clipboard
#   (needs accessibility permission).
injection_mode = "clipboard"

# Optional: Continuous dictation toggle hotkey. Default: ctrl+alt+d
# (not ctrl+alt+space — that clashes with Claude Code).
# Must differ from hotkey above (modifier order and aliases like control/ctrl,
# win/cmd are ignored when comparing). Env: VOX_CONTINUOUS_HOTKEY.
# continuous_hotkey = "ctrl+alt+d"

# Optional: Pause length in seconds before an Utterance is Committed. Default: 1.0.
# Must be a finite number greater than 0. Env: VOX_CONTINUOUS_PAUSE_SECONDS.
# continuous_pause_seconds = 1.0

# Optional: Idle minutes before Continuous auto-off. Default: 5.
# Must be a finite number greater than 0. Env: VOX_CONTINUOUS_IDLE_MINUTES.
# continuous_idle_minutes = 5
